# Public site URL (used for canonical + Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://thinktrygo.com

# Optional: Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Supabase (server-side only — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to waitlist_signups
SUPABASE_TABLE=waitlist_signups
