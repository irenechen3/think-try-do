# Public site URL (used for canonical + Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://thinktrygo.com

# Optional: Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Supabase (server-side only — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to waitlist_signups
SUPABASE_TABLE=waitlist_signups

# Resend (optional) — sign-up emails. Without RESEND_API_KEY no emails are sent.
RESEND_API_KEY=
# Where new-sign-up alerts go
NOTIFY_EMAIL=
# Sender for both emails (domain must be verified in Resend)
EMAIL_FROM="Think Try Go <hello@thinktrygo.com>"
# Where parents' replies go. Defaults to NOTIFY_EMAIL.
EMAIL_REPLY_TO=
